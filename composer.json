{
    "name": "odds-aggregator/odds-aggregator",
    "description": "Live odds comparison from multiple bookmakers.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "OddsAggregator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OddsAggregator\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text --coverage-html coverage",
        "test:integration": "phpunit -c phpunit-integration.xml.dist"
    },
    "scripts-descriptions": {
        "test": "Runs the unit suite; needs no network and no WordPress.",
        "test:coverage": "Runs the unit suite with a coverage report; needs pcov or Xdebug.",
        "test:integration": "Runs the opt-in suite against the live feeds; skips without credentials."
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
